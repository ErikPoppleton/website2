---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Personal website and blog' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Runs before first paint so a non-default colormap doesn't flash viridis.
      try {
        const saved = localStorage.getItem('holo-map');
        if (saved) document.documentElement.dataset.holo = saved;
      } catch {
        /* private mode / storage disabled: fall through to the viridis default */
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Nav />

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-sm text-[var(--color-text-muted)]">
            Built with <a href="https://astro.build" class="hover:text-[var(--color-accent)]">Astro</a>
          </p>
          <div class="flex items-center gap-6">
            <div class="holo-picker">
              <label for="holo-map" class="sr-only">Border colormap</label>
              <span class="holo-picker__swatch" aria-hidden="true"></span>
              <select id="holo-map" class="holo-picker__select">
                <option value="viridis">viridis</option>
                <option value="plasma">plasma</option>
                <option value="magma">magma</option>
                <option value="inferno">inferno</option>
                <option value="cividis">cividis</option>
                <option value="twilight">twilight</option>
                <option value="turbo">turbo</option>
              </select>
            </div>
            <div class="flex space-x-4">
              <a href="https://github.com/erikpoppleton" class="text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]" aria-label="GitHub">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                </svg>
              </a>
              <a href="https://bsky.app/profile/poppleton.phd" class="text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]" aria-label="Bluesky">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 01-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z" />
                </svg>
              </a>
              <a href="https://www.linkedin.com/in/erik-poppleton-473098218/" class="text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]" aria-label="LinkedIn">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              </a>
              <a href="https://scholar.google.com/citations?user=nmkgqNEAAAAJ" class="text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]" aria-label="Google Scholar">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 24a7 7 0 110-14 7 7 0 010 14zm0-24L0 9.5l4.838 3.94A8 8 0 0112 9a8 8 0 017.162 4.44L24 9.5 12 0z" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>
    <script>
      // Holographic scroll effect
      function updateHoloEffect() {
        const scrollY = window.scrollY;
        const offset = (scrollY * 0.25) % 360;
        document.documentElement.style.setProperty('--holo-offset', String(offset));
      }

      window.addEventListener('scroll', updateHoloEffect, { passive: true });
      updateHoloEffect();

      // Colormap picker
      const holoSelect = document.getElementById('holo-map');
      if (holoSelect instanceof HTMLSelectElement) {
        holoSelect.value = document.documentElement.dataset.holo || 'viridis';

        holoSelect.addEventListener('change', () => {
          document.documentElement.dataset.holo = holoSelect.value;
          try {
            localStorage.setItem('holo-map', holoSelect.value);
          } catch {
            /* choice just won't persist across pages */
          }
        });
      }
    </script>
  </body>
</html>
