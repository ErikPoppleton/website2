---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StarRating from '../../components/StarRating.astro';
import { getVisiblePosts } from '../../lib/posts';

const posts = await getVisiblePosts();

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Blog | Erik Poppleton" description="Thoughts on science, programming, and more">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-[var(--color-text-primary)] mb-4">Blog</h1>
      <p class="text-lg text-[var(--color-text-secondary)]">
        I'm not sure how much I will actually use this, but somebody once told me that the best way to stress-test your thoughts is to see if you're willing to put them on the internet.
      </p>
      <p class="text-lg text-[var(--color-text-secondary)]">
        So here are some thoughts, tastes, and takes for the world to see!
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">No posts yet. Check back soon!</p>
    ) : (
      <ul class="space-y-8">
        {posts.map((post) => (
          <li>
            <article class="group">
              <a href={`/blog/${post.slug}`} class="block">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-sm text-[var(--color-text-muted)] font-mono"
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <h2 class="text-xl font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors mt-1 mb-2">
                  {post.data.draft && (
                    <span class="align-middle mr-2 px-2 py-0.5 text-xs font-mono uppercase tracking-wide text-[#f5b301] border border-[#f5b301] rounded">
                      draft
                    </span>
                  )}
                  {post.data.title}
                </h2>
                {post.data.postType === 'review' && post.data.rating !== undefined && (
                  <div class="mb-2">
                    <StarRating rating={post.data.rating} size={16} />
                  </div>
                )}
                <p class="text-[var(--color-text-secondary)]">
                  {post.data.description}
                </p>
                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-3">
                    {post.data.tags.map((tag) => (
                      <span class="px-2 py-1 text-xs font-mono bg-[var(--color-bg-tertiary)] text-[var(--color-text-muted)] rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </article>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
