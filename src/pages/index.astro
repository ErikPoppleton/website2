---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OxViewEmbed from '../components/OxViewEmbed.astro';
import BlueskyFeed from '../components/BlueskyFeed.astro';
import PodcastFeed from '../components/PodcastFeed.astro';
---

<BaseLayout title="Erik Poppleton" description="Personal website - scientist and developer">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <!-- Hero Section -->
    <section class="mb-16">
      <h1 class="text-4xl sm:text-5xl font-bold text-[var(--color-text-primary)] mb-4">
        Erik Poppleton
      </h1>
      <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl">
        Scientist—Molecular Programmer—Software Developer <br>
        Using data- and physics-driven methods to advance nucleic acid structural biology and molecular design.
      </p>
    </section>

    <!-- Projects Section -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-[var(--color-text-primary)] mb-6">
        <span class="font-mono text-[var(--color-accent)]"></span> Software
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <ProjectCard
          title="oxDNA"
          description="Coarse-grained simulations of DNA/RNA nanotechnology and biophysics."
          href="https://github.com/lorenzo-rovigatti/oxDNA"
          tags={['Python', 'C++', 'Simulation']}
        />
        <ProjectCard
          title="oxView"
          description="Web-based visualization and editing tool for DNA/RNA nanostructures."
          href="https://github.com/sulcgroup/oxdna-viewer"
          tags={['TypeScript', 'Three.js', 'WebGL']}
        />
      </div>
    </section>

    <!-- Social Feeds Section -->
    <section>
      <h2 class="text-2xl font-bold text-[var(--color-text-primary)] mb-6">
        <span class="font-mono text-[var(--color-accent)]"></span> Demos and feeds
      </h2>
      <div class="grid gap-4 sm:grid-cols-2 items-start">
        <!-- Left column -->
        <div class="space-y-4">
          <OxViewEmbed
            title="oxView Demo"
            topFile="/images/nNE.top"
            datFile="/images/nNE.dat"
            camFile="/images/nNE_camera.cam"
          />
          <PodcastFeed
            feedUrl="https://podcast.molpi.gs/podcast.rss"
            title="Molpigs Podcast"
            limit={5}
          />
        </div>
        <!-- Right column -->
        <BlueskyFeed feedUrl="https://bsky.app/profile/poppleton.phd/feed/aaabyxg7h7vqq" title="Molecular Programming Bluesky Feed" />
      </div>
    </section>
  </div>
</BaseLayout>
